{
  "name": "emuflight-configurator",
  "productName": "EmuConfigurator",
  "description": "Crossplatform configuration tool for Emuflight flight control system.",
  "version": "0.4.3",
  "max_msp": "1.54.0",
  "COMMENT": "MAX_MSP required!!!!",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.0.0",
    "yarn": "1.22.x"
  },
  "main": "main.js",
  "default_locale": "en",
  "scripts": {
    "setup:hooks": "node .github/scripts/setup-hooks.js",
    "dev": "yarn install --check-files && node scripts/build.js && cross-env NODE_ENV=development NODE_NO_WARNINGS=1 electron-forge start",
    "debug": "yarn dev",
    "dev:verbose": "yarn install --check-files && node scripts/build.js && cross-env NODE_ENV=development electron-forge start",
    "make": "yarn install --check-files && node scripts/build.js && electron-forge make",
    "make:dev": "yarn make:debug",
    "make:debug": "yarn install --check-files && node scripts/build.js && cross-env EMUCFG_BUILD_MODE=dev-release electron-forge make",
    "package": "yarn install --check-files && node scripts/build.js && electron-forge package",
    "package:debug": "yarn install --check-files && node scripts/build.js && cross-env EMUCFG_BUILD_MODE=dev-release electron-forge package",
    "build": "node scripts/build.js",
    "verify:cross-env": "cross-env EMUCFG_VERIFY_CROSS_ENV=cross-env-ok node scripts/verify-cross-env.js",
    "lint": "eslint .",
    "commands": "node .commands.js"
  },
  "repository": {
    "type": "git",
    "url": "github.com/emuflight/EmuConfigurator"
  },
  "webview": {
    "partitions": [
      {
        "name": "map",
        "accessible_resources": [
          "tabs/map.html",
          "js/tabs/map.js",
          "/js/libraries/openlayers/ol.css",
          "/js/libraries/openlayers/ol.js",
          "/images/icons/cf_icon_position.png",
          "/images/icons/cf_icon_position_nofix.png"
        ]
      }
    ]
  },
  "author": "The Emuflight open source project.",
  "license": "GPL-3.0",
  "dependencies": {
    "bluebird": "^3.7.2",
    "i18next": "^26.4.0",
    "i18next-xhr-backend": "^3.2.2",
    "inflection": "3.0.2",
    "jbox": "1.3.3",
    "jquery": "3.5.0",
    "jquery-flight-indicators": "^1.0.0",
    "jquery-textcomplete": "^1.8.5",
    "jquery-throttle-debounce": "^1.0.0",
    "jquery-ui-npm": "1.12.0",
    "marked": "^18.0.11",
    "object-hash": "^3.0.0",
    "serialport": "^13.0.0",
    "usb": "^3.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-wix": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "44.0.0",
    "eslint": "^8.57.0",
    "fs-extra": "^11.4.0"
  },
  "resolutions": {
    "yauzl": "3.3.2"
  }
}
